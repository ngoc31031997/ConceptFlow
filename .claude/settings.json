{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch -m *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(make help)",
      "Bash(make setup)",
      "Bash(make setup *)",
      "Bash(make build)",
      "Bash(make check)",
      "Bash(make check *)",
      "Bash(make check-all)"
    ],
    "ask": [
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(docker exec *)",
      "Bash(*migrate-authoring-data.sh*)",
      "Edit(/.github/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/scripts/hooks/**)",
      "Edit(/scripts/check.sh)",
      "Edit(/scripts/review-prep.sh)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down * -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker compose down * --volumes*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Read(**/.env)",
      "Read(**/.env.window)",
      "Read(**/secrets/**)",
      "Read(**/client_secret_*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.window)",
      "Edit(**/secrets/**)",
      "Edit(**/client_secret_*.json)",
      "Edit(/.git/conceptflow/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard_bash.py", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/lint-edited.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-check.sh", "timeout": 600 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/record_review.py", "timeout": 30 }
        ]
      }
    ]
  }
}
