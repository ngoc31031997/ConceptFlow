.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
dist/
.env
.env.window
*.tsbuildinfo
.venv/

# Google OAuth client secrets. The YouTube credential is read from .env
# (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET); the JSON Google Cloud hands you on
# download must never reach the remote — this repo has a public origin.
client_secret_*.json

# Google OAuth client_secret files (CR-012) — never commit these
secrets/*.json

# Default host bind-mount target for shared_artifacts (video output) — see
# VIDEO_OUTPUT_HOST_DIR in .env.example. Contents can be large.
data/shared_artifacts/*
!data/shared_artifacts/.gitkeep

# Manim ghi cache/output vào ./media khi chạy ngoài container
media/

# graphify code knowledge graph: local only, rebuilt by `make graph` and the
# graphify git hooks (docs/agentic/graphify.md)
graphify-out/

# Reference videos the Creator keeps locally to compare output against
example/

# One git worktree per CR/fix (scripts/worktree.sh); each is its own checkout
.claude/worktrees/
