{
  "id": null,
  "uid": "concertflow-pipeline",
  "title": "ConceptFlow Pipeline",
  "tags": [
    "concertflow"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "current": {
          "text": "rendering",
          "value": "rendering"
        },
        "options": [
          {
            "text": "api-gateway",
            "value": "api-gateway"
          },
          {
            "text": "orchestrator",
            "value": "orchestrator"
          },
          {
            "text": "script-processing",
            "value": "script-processing"
          },
          {
            "text": "tts",
            "value": "tts"
          },
          {
            "text": "rendering",
            "value": "rendering",
            "selected": true
          },
          {
            "text": "video-assembly",
            "value": "video-assembly"
          },
          {
            "text": "publisher",
            "value": "publisher"
          },
          {
            "text": "web-gui",
            "value": "web-gui"
          }
        ],
        "query": "api-gateway,orchestrator,script-processing,tts,rendering,video-assembly,publisher,web-gui",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Pipeline error rate (last 15m per service)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "api-gateway",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"api-gateway\"} |~ `(?i)error|exception|traceback|panic|fatal` [15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
