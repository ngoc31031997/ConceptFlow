# RabbitMQ (Unit 1: RabbitMQ Infrastructure)
RABBITMQ_USER=changeme_user
RABBITMQ_PASS=changeme_password

# PostgreSQL — database-per-service for Inbox/Outbox (ADR-0013)
POSTGRES_USER=changeme_user
POSTGRES_PASS=changeme_password

# YouTube OAuth 2.0 (Unit 7: Publisher Service, CR-012)
#
# OAuth clients are NOT configured here any more. Drop each client_secret*.json
# downloaded from Google Cloud Console into the repo's secrets/ directory —
# see secrets/README.md. One file = one GCP project = one quota bucket
# (~6 uploads/day); several files raise that ceiling, several channels on one
# file do not.
#
# Every client must list GOOGLE_OAUTH_REDIRECT_URI verbatim under its
# Authorized redirect URIs, or connecting fails with redirect_uri_mismatch.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/youtube/callback

# Legacy single-app fallback, kept so a pre-CR-012 .env keeps working.
# Leave both blank once secrets/ holds at least one client_secret file.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Grafana (centralized logging — Loki + Promtail + Grafana)
GRAFANA_USER=changeme_user
GRAFANA_PASS=changeme_password

# --- Video output storage (shared_artifacts) ---
# Absolute path ON THE HOST where rendered clips, assembled final videos,
# captions and channel assets are written. This is a bind mount, not a
# Docker-managed volume — output can get large, and a host path is easier to
# monitor free space on, move, or clean up than Docker's own volume storage.
# The directory must already exist before `docker compose up`.
# Leave unset and it falls back to ./data/shared_artifacts inside the repo.
# VIDEO_OUTPUT_HOST_DIR=/Volumes/ExternalDrive/conceptflow-output

# --- Google Cloud Text-to-Speech (ADR-0023, optional, dormant) ---
# Absolute path ON THE HOST to a service-account JSON key with the Cloud
# Text-to-Speech API enabled. Leave this unset and the Google voices in the
# catalogue fall back to the equivalent Edge voice.
#
# Google withdrew the WaveNet free tier this branch was chosen for (CR-010), so
# every character sent here is billed. Prefer the Azure or Edge voices below.
# GOOGLE_TTS_CREDENTIALS_FILE=/Users/you/secrets/google-tts.json

# --- Azure AI Speech (CR-011, optional) ---
# Key + region from an Azure Speech resource (Keys and Endpoint page). Create
# the resource on the F0 pricing tier: 500,000 neural characters a month, free,
# no expiry — roughly twice this pipeline's expected usage.
# Leave unset to run without an Azure account: the Azure voices in the catalogue
# then fall back to the identical Edge voice, which needs no credentials but is
# an undocumented endpoint with no SLA (ADR-0024).
# AZURE_SPEECH_KEY=changeme_speech_key
# AZURE_SPEECH_REGION=southeastasia


# --- Hive AI (CR-027, LLM provider chính cho pipeline soạn kịch bản) ---
# Tạo Secret Key ở mục Service API Keys trên dashboard Hive. Chỉ cần Secret
# Key — auth là `Authorization: Bearer <secret>`, Access Key ID không dùng tới.
# Để trống thì hệ thống chạy như trước CR-027: mọi prompt vẫn copy tay ra AI
# ngoài, và suggest-metadata/suggest-short-script dùng Ollama nội bộ.
# HIVE_API_KEY=
# LLM_PROVIDER quyết định nút "Chạy bằng AI" ở bước 1 có hiện không: chỉ
# `hive` + có HIVE_API_KEY thì mới hiện (CR-027 FR79.4). Để trống thì suy ra
# từ HIVE_API_KEY (có key → hive, không → ollama). Dù chọn gì, nút
# "Copy prompt" vẫn luôn còn — đó là đường đi không cần API (FR77.4).
# LLM_PROVIDER=hive
# HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
# HIVE_MODEL=deepseek-ai/deepseek-v4.1-flash
# HIVE_TIMEOUT_SECONDS=0   # 0 = không timeout (đợi Hive trả lời)
