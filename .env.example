# RabbitMQ (Unit 1: RabbitMQ Infrastructure)
RABBITMQ_USER=changeme_user
RABBITMQ_PASS=changeme_password

# PostgreSQL — database-per-service for Inbox/Outbox (ADR-0013)
POSTGRES_USER=changeme_user
POSTGRES_PASS=changeme_password

# YouTube OAuth 2.0 (Unit 7: Publisher Service) — register an OAuth Client
# on Google Cloud Console (APIs & Services > Credentials > OAuth client ID,
# type "Web application"), enable the YouTube Data API v3, and add
# GOOGLE_OAUTH_REDIRECT_URI to the client's authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=changeme_client_id
GOOGLE_OAUTH_CLIENT_SECRET=changeme_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/v1/auth/youtube/callback

# Grafana (centralized logging — Loki + Promtail + Grafana)
GRAFANA_USER=changeme_user
GRAFANA_PASS=changeme_password

# --- Google Cloud Text-to-Speech (ADR-0023, optional) ---
# Absolute path ON THE HOST to a service-account JSON key with the Cloud
# Text-to-Speech API enabled. Leave this unset to run entirely offline: the TTS
# Service then uses the bundled Piper voices, which are noticeably lower
# quality and are the largest monetization risk in this pipeline.
#
# The WaveNet tier's free allowance is 4,000,000 characters/month — roughly 500
# ten-minute videos — so at a personal channel's pace this costs nothing.
# GOOGLE_TTS_CREDENTIALS_FILE=/Users/you/secrets/google-tts.json
